# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# GitHub Copilot Configuration
GITHUB_COPILOT_CLIENT_ID=Iv1.b507a08c87ecfe98

# Copilot API base URL.
# Normally discovered automatically from the token's `endpoints.api` field
# (individual plans resolve to https://api.individual.githubcopilot.com).
# Only set this to force a specific host.
# COPILOT_API_BASE=https://api.githubcopilot.com

# Editor identity headers sent upstream. Copilot gates newer models behind
# recent editor versions, so these can be bumped without a code change.
COPILOT_INTEGRATION_ID=vscode-chat
COPILOT_EDITOR_VERSION=vscode/1.102.0
COPILOT_PLUGIN_VERSION=copilot-chat/0.26.7
COPILOT_USER_AGENT=GitHubCopilotChat/0.26.7
COPILOT_API_VERSION=2025-04-01

# Models
# Used when a request omits a model name
DEFAULT_MODEL=claude-opus-5
# Set to 1 to also list non-Anthropic Copilot models on /v1/models
# EXPOSE_ALL_MODELS=1
# How long to cache the discovered model catalog (ms)
MODEL_CACHE_TTL_MS=3600000

# Rate Limiting
# Requests per minute. Agentic tool loops are bursty, so this is generous.
RATE_LIMIT_DEFAULT=600
# Requests per minute for chat completions
RATE_LIMIT_CHAT_COMPLETIONS=600
# Set to 1 to disable rate limiting entirely
# DISABLE_RATE_LIMIT=1

# Logging
LOG_LEVEL=info

# Where OAuth tokens are persisted.
# Defaults to ~/.github-copilot-proxy; the Docker image sets this to /data so a
# mounted volume keeps you signed in across rebuilds.
# COPILOT_PROXY_DATA_DIR=/data
